# 复制为 deploy/.env 后修改，切勿提交真实密码到仓库

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_USERNAME=tickethub
MYSQL_PASSWORD=change_me_app

# ---- Redis（留空表示不设密码，生产建议设置）----
REDIS_PASSWORD=

# ---- RabbitMQ ----
RABBITMQ_USERNAME=tickethub
RABBITMQ_PASSWORD=change_me_mq

# ---- 阿里云 OSS（图片上传，不需要可保持 false）----
OSS_ENABLED=false
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=your-bucket
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_URL_PREFIX=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
