# ============================================================
# TicketHub 环境变量模板
#
# 用法：
#   cp deploy/.env.example deploy/.env
#   vim deploy/.env      # 把所有 change_me 换成真实密码
#
# 安全须知：
#   deploy/.env 已被 .gitignore 忽略，绝对不要提交到 GitHub。
#   里面的密码就是生产密码，泄露等于数据库裸奔。
# ============================================================

# ---------------- MySQL ----------------
# root 密码：仅容器内部使用（3306 不对公网暴露），
# 但备份/排错时要用来登录，建议用强密码并记到密码管理器。
MYSQL_ROOT_PASSWORD=change_me_root

# 应用专用账号（权限只给 tickethub 库，不要用 root 跑应用）
MYSQL_USERNAME=tickethub
MYSQL_PASSWORD=change_me_app

# ---------------- Redis ----------------
# 留空表示不设密码。因为 Redis 端口只在 Docker 内网暴露、公网访问不到，
# 演示环境留空可以接受；若将来把 Redis 挪到公网或云 Redis，必须设置强密码。
REDIS_PASSWORD=

# ---------------- RabbitMQ ----------------
# 抢票异步出票用。管理页 15672 默认不对公网暴露，
# 需要看队列时用 SSH 隧道访问（见 docs/DEPLOY.md 第 4 章）。
RABBITMQ_USERNAME=tickethub
RABBITMQ_PASSWORD=change_me_mq

# ---------------- JVM（2核2G 机器必看）----------------
# 2G 内存的 ECS 上，四个容器 + 系统本身已经很紧张，
# JVM 堆必须限制在 512M。若你的机器是 4G，可改成 -Xmx1g。
# 注意：修改后要 docker compose up -d 重建容器才生效。
JAVA_OPTS=-Xms256m -Xmx512m -XX:MaxMetaspaceSize=160m -Xss512k -XX:+UseSerialGC -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai

# ---------------- 阿里云 OSS（可选，香港桶）----------------
# 用途：只存用户上传的图片（演出海报、动态配图）。
#
# 为什么用香港桶：香港地域不需要 ICP 备案，可以先用默认域名访问图片。
# 注意：OSS 默认域名访问 .html 会被强制下载，所以本项目的前端页面
# 不走 OSS，而是由 ECS 上的 nginx 托管（详见 docs/DEPLOY.md 第 0 章）。
#
# 不配置 OSS（OSS_ENABLED=false）时，上传的图片会落到服务器本地目录
# /opt/tickethub/uploads，由 nginx 的 /imgs/ 直接托管，同样能正常显示。
OSS_ENABLED=false

# Endpoint 填你桶所在地域的公网访问域名，香港是 oss-cn-hongkong.aliyuncs.com
OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com
OSS_BUCKET=your-bucket-name

# AccessKey 建议使用 RAM 子账号，只授予该 bucket 的读写权限（不要用主账号 AK）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 图片访问前缀。默认域名格式：https://<bucket>.<endpoint>
OSS_URL_PREFIX=https://your-bucket-name.oss-cn-hongkong.aliyuncs.com
